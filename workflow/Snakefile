        expand("logs/report_{sample}.log", sample=SAMPLES),
        "logs/report_all.log",
    output:
        "stats.logg",
    shell:
        "cat {input} > {output}"


# Pagina inicial do relatorio, com o resumo de cada amostra.
rule index_page:
