# VirusHunter -- workflow Snakemake.
#
# Substitui o gerador de scripts shell. A execucao e local, entao o envelope de
# distribuicao por SSH nao foi traduzido: desapareceu. Ver ADR-0016.
#
# Cobre a configuracao de referencia: single-end, sem montagem, sem remocao de
# adaptador, filtro NR por DIAMOND. Rotas opcionais ainda nao migradas.
#
#   snakemake -n                     valida o DAG sem executar
#   snakemake --cores 8              execucao local
#   snakemake --configfile meu.yaml  sobrepoe config/default.yaml

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(workflow.basedir).parent / "src"))

from virushunter.config import load as load_config
from virushunter.workflow import discover_samples, fastq_files, resolve_config

cfg = resolve_config(config, workflow.basedir)

SAMPLES = discover_samples(cfg["io.fastq_dir"])
FASTQ = fastq_files(cfg["io.fastq_dir"])
SPLITS = list(range(cfg["compute.query_splits"]))
LIB = cfg["io.library_prefix"]

TOOLS = cfg.get("tools")
DB = cfg.get("databases")
SCRIPTS = cfg["tools.scripts_dir"]

# Restrito aos nomes reais: os agregados usam "all" nos mesmos padroes de arquivo,
# e sem isso o Snakemake tenta produzir fastq/all.fa como se fosse uma amostra.
wildcard_constraints:
    sample="|".join(re.escape(s) for s in SAMPLES),
    split=r"\d+",


# Alvo final
rule all:
    input:
        expand("blast_filter_out/{sample}_blast_filter.html", sample=SAMPLES),
        "blast_filter_out/all_blast_filter.html",
        "report/hitTable",
        "report/index.html",
        expand("report/pie/{sample}_blast_filter.png", sample=SAMPLES),


# Depleção de hospedeiro
rule host_align:
    input:
        # Resolved from what is on disk: sample S1 lives in a file called
        # A_S1_L001_R1_001.fastq.gz, and the surrounding parts are not derivable
        # from the sample name.
        fastq=lambda w: FASTQ[(w.sample, w.pair)],
    output:
        sam=temp("fastq/{sample}_{pair}_0.sam"),
    params:
        index=DB["human_bowtie_index"],
        bowtie2=TOOLS["bowtie2"],
    threads: cfg["compute.threads"]
    shell:
        # --reorder e --no-hd sao obrigatorios: os SAMs sao lidos em lockstep
        # posicional e a contagem de linhas precisa igualar a de leituras (I2).
        "{params.bowtie2} --quiet --local --very-fast-local --no-hd --reorder "
        "-p {threads} -x {params.index} -U {input.fastq} -S {output.sam}"


rule host_filter:
    input:
        sam="fastq/{sample}_1_0.sam",
    output:
        filtered="fastq/{sample}_1.fil",
    params:
        script=SCRIPTS + "sam2fq_bac.py",
        prefix=lambda w: f"fastq/{w.sample}",
    shell:
        # Mascara, nao remove: a identidade e a posicao no arquivo (I1).
        "python {params.script} {params.prefix} 0 0 {output.filtered}"


# Deduplicação clonal
rule dedup:
    input:
        "fastq/{sample}_1.fil",
    output:
        "fastq/{sample}_1.dup",
    params:
        script=SCRIPTS + "dedup.py",
    shell:
        "python {params.script} {input} {output}"


# Recodificação de identidade
rule recode_ids:
    input:
        "fastq/{sample}_1.dup",
    output:
        "fastq/{sample}_1.trim",
    params:
        script=SCRIPTS + "recodeID.py",
        label=lambda w: f"{LIB}_{w.sample}",
    shell:
        "python {params.script} {input} {output} {params.label} 1"


rule length_filter:
    input:
        "fastq/{sample}_1.trim",
    output:
        "fastq/{sample}_1_sequence.txt",
    params:
        script=SCRIPTS + "fq_pair_clean.py",
        min_length=5,
    shell:
        "python {params.script} {input} {output} {params.min_length}"


# Preparo das leituras
rule reads_to_fastq:
    input:
        "fastq/{sample}_1_sequence.txt",
    output:
        "fastq/{sample}.fq",
    shell:
        "cat {input} > {output}"


rule reads_to_fasta:
    input:
        "fastq/{sample}.fq",
    output:
        "fastq/{sample}.fa",
    params:
        script=SCRIPTS + "fq2fa.py",
        min_length=cfg["params.min_read_length"],
    shell:
        "python {params.script} {input} {output} {params.min_length}"


# Query do BLAST
def query_parts(wildcards):
    """Contigs entram na query so quando ha montagem."""
    parts = [f"fastq/{wildcards.sample}.fa"]
    if cfg["steps.assembly.mode"] != "no":
        parts.insert(0, f"fastq/{wildcards.sample}_contig4")
    return parts


rule build_query:
    input:
        query_parts,
    output:
        "fastq/{sample}_c",
    shell:
        "cat {input} > {output}"


rule split_query:
    input:
        "fastq/{sample}_c",
    output:
        expand("fastq/{{sample}}_c_{split}", split=SPLITS),
    params:
        script=SCRIPTS + "splitQuery.py",
        n=cfg["compute.query_splits"],
    shell:
        "python {params.script} {input} {params.n}"


# Triagem viral
rule blast_virus:
    input:
        "fastq/{sample}_c_{split}",
    output:
        "blast_virus_out/{sample}_blast.xml_{split}",
    params:
        blastx=TOOLS["blastx"],
        db=DB["virus_protein"],
        evalue=cfg["params.evalue"],
    threads: cfg["compute.threads"]
    shell:
        "{params.blastx} -num_threads {threads} -evalue {params.evalue} -outfmt 5 "
        "-dbsize 10000000 -searchsp 1000000000 -max_target_seqs 1 "
        "-db_soft_mask 21 -best_hit_overhang 0.1 -best_hit_score_edge 0.1 "
        "-db {params.db} -query {input} -out {output}"


rule parse_virus_hits:
    input:
        xml="blast_virus_out/{sample}_blast.xml_{split}",
        query="fastq/{sample}_c_{split}",
    output:
        significant="fastq/{sample}_c_{split}_s",
        mystery="blast_filter_out/tmp/{sample}_prem.fasta_{split}",
    params:
        script=SCRIPTS + "blast_parser.py",
        myslen=cfg["params.mystery_min_length"],
        evalue=cfg["params.evalue"],
        log="blast_virus.log",
    shell:
        "python {params.script} {input.xml} {input.query} {output.significant} "
        "{output.mystery} {params.myslen} {params.evalue} {params.log}"


rule merge_significant:
    input:
        expand("fastq/{{sample}}_c_{split}_s", split=SPLITS),
    output:
        "fastq/{sample}_sig",
    shell:
        "cat {input} > {output}"


# Filtro contra NR
rule diamond_nr:
    input:
        "fastq/{sample}_sig",
    output:
        "diamond_nr_out/{sample}.m8",
    params:
        diamond=TOOLS["diamond"],
        db=DB["diamond_nr"],
    threads: cfg["compute.threads"]
    shell:
        "{params.diamond} blastx --quiet --max-target-seqs 1 --outfmt 6 "
        "-d {params.db} -q {input} -o {output}"


rule filter_against_nr:
    input:
        xml="blast_virus_out/{sample}_blast.xml_{split}",
        m8="diamond_nr_out/{sample}.m8",
        query="fastq/{sample}_c_{split}",
    output:
        "blast_filter_out/{sample}_blast_filter.txt_{split}",
    params:
        script=SCRIPTS + "diamond_filter_NR.py",
        evalue=cfg["params.evalue"],
        hsp=cfg["params.hsp_only"],
    shell:
        "python {params.script} {input.xml} {input.m8} {input.query} {output} "
        "{params.evalue} {params.hsp}"


rule merge_filtered:
    input:
        expand("blast_filter_out/{{sample}}_blast_filter.txt_{split}", split=SPLITS),
    output:
        "blast_filter_out/{sample}_blast_filter.txt",
    shell:
        # Blocos posicionais de 11 linhas; a concatenacao so vale porque todos
        # tem o mesmo tamanho (I4).
        "cat {input} > {output}"


rule merge_all_samples:
    input:
        expand("blast_filter_out/{sample}_blast_filter.txt", sample=SAMPLES),
    output:
        "blast_filter_out/all_blast_filter.txt",
    shell:
        "cat {input} > {output}"


# Concatena os contigs sem hit das 50 fatias. Alimenta o relatorio, que roda
# dustmasker sobre eles para marcar baixa complexidade.
rule merge_mystery:
    input:
        expand("blast_filter_out/tmp/{{sample}}_prem.fasta_{split}", split=SPLITS),
    output:
        "report/mystery/{sample}_m.fasta",
    shell:
        "cat {input} > {output}"


rule merge_mystery_all:
    input:
        expand("report/mystery/{sample}_m.fasta", sample=SAMPLES),
    output:
        "report/mystery/all_m.fasta.out",
    shell:
        "cat {input} > {output}"


# blast_output_sort.py escreve tambem um arquivo por virus em aln/ e fasta/, mas
# todas as amostras compartilham esses diretorios. Nao sao declarados como saida:
# o Snakemake -- corretamente -- recusa dois jobs escrevendo no mesmo diretorio, e
# forcar isso esconderia a colisao em vez de resolve-la. Quem depende deles
# depende dos .html por amostra, que sao declarados.
rule report_sample:
    input:
        filtered="blast_filter_out/{sample}_blast_filter.txt",
        reads="fastq/{sample}.fa",
        mystery="report/mystery/{sample}_m.fasta",
    output:
        summary="blast_filter_out/{sample}_blast_filter.html",
        excel="blast_filter_out/{sample}_blast_filter.xls",
        pie="blast_filter_out/pie/{sample}_blast_filter.txt",
        table="blast_filter_out/table/{sample}_blast_filter.txt",
        masked="report/mystery/{sample}_m_complex.fasta",
        sorted_mystery="report/mystery/{sample}_m_complex_sort.fasta",
    params:
        script=SCRIPTS + "blast_output_sort.py",
        fasort=SCRIPTS + "faSort.py",
        dustmasker=TOOLS["dustmasker"],
        scripts_dir=SCRIPTS,
        base="report",
    log:
        "logs/report_{sample}.log",
    shell:
        "python {params.script} {input.filtered} {input.reads} {params.scripts_dir} "
        "{params.base} {params.base} > {log} 2>&1 && "
        "{params.dustmasker} -in {input.mystery} -infmt fasta -outfmt fasta "
        "-out {output.masked} && "
        "python {params.fasort} {output.masked} {output.sorted_mystery} True"


# A variante agregada recebe '--' no lugar do FASTA, o que faz o script pular a
# recuperacao de pares e ativar a contagem por barcode. Modo distinto, nao mais
# uma amostra.
rule report_all:
    input:
        filtered="blast_filter_out/all_blast_filter.txt",
        mystery="report/mystery/all_m.fasta.out",
        per_sample=expand("blast_filter_out/{sample}_blast_filter.html", sample=SAMPLES),
    output:
        summary="blast_filter_out/all_blast_filter.html",
        excel="blast_filter_out/all_blast_filter.xls",
        pie="blast_filter_out/pie/all_blast_filter.txt",
        table="blast_filter_out/table/all_blast_filter.txt",
        masked="report/mystery/all_m_complex.fasta",
        sorted_mystery="report/mystery/all_m_complex_sort.fasta",
    params:
        script=SCRIPTS + "blast_output_sort.py",
        fasort=SCRIPTS + "faSort.py",
        dustmasker=TOOLS["dustmasker"],
        scripts_dir=SCRIPTS,
        base="report",
    log:
        "logs/report_all.log",
    shell:
        "python {params.script} {input.filtered} -- {params.scripts_dir} "
        "{params.base} {params.base} > {log} 2>&1 && "
        "{params.dustmasker} -in {input.mystery} -infmt fasta -outfmt fasta "
        "-out {output.masked} && "
        "python {params.fasort} {output.masked} {output.sorted_mystery}"


rule merge_table:
    input:
        all_table="blast_filter_out/table/all_blast_filter.txt",
        per_sample=expand("blast_filter_out/table/{sample}_blast_filter.txt", sample=SAMPLES),
    output:
        "report/hitTable",
    params:
        script=SCRIPTS + "mergeTable.py",
    shell:
        "python {params.script} {input.all_table} {input.per_sample} {output}"


rule plot_pie:
    input:
        "blast_filter_out/pie/{sample}_blast_filter.txt",
    output:
        "report/pie/{sample}_blast_filter.png",
    params:
        script=SCRIPTS + "plot_pie.py",
    log:
        "logs/plot_pie_{sample}.log",
    shell:
        "python {params.script} {input} > {log} 2>&1 && "
        "mv $(dirname {input})/$(basename {input}).png {output} 2>/dev/null || touch {output}"


# firstpage.py le stats.logg, que no original era `cat *.log` -- um canal lateral
# sem dependencia declarada. Aqui os logs sao entradas explicitas da regra.
rule collect_metrics:
    input:
        expand("logs/report_{sample}.log", sample=SAMPLES),
        "logs/report_all.log",
    output:
        "stats.logg",
    shell:
        "cat {input} > {output}"


rule index_page:
    input:
        stats="stats.logg",
        summaries=expand("blast_filter_out/{sample}_blast_filter.html", sample=SAMPLES),
        all_summary="blast_filter_out/all_blast_filter.html",
        table="report/hitTable",
    output:
        "report/index.html",
    params:
        script=SCRIPTS + "firstpage.py",
    log:
        "logs/index.log",
    shell:
        "python {params.script} no > {log} 2>&1 && mv index.html {output}"


# ---------------------------------------------------------------------------
# Montagem ensemble SAVaC -- SOAPdenovo2, ABySS, MetaVelvet, ABySS particionado,
# consenso por CAP3. E a combinacao publicada em Deng et al. 2015 e a unica
# configuracao que o metodo exige. So entra no DAG com assembly.mode == "denovo".
# ---------------------------------------------------------------------------
ASSEMBLY = cfg["steps.assembly.mode"]


rule prepare_abyss_reads:
    input:
        "fastq/{sample}.fq",
    output:
        "fastq/{sample}abyss.fq",
    params:
        script=SCRIPTS + "fqLenFilter.py",
        min_length=35,
    shell:
        "python {params.script} {input} {output} {params.min_length}"


# O numero de fatias depende do tamanho da amostra, e so e conhecido depois de
# rodar. checkpoint e o mecanismo do Snakemake para isso; o gerador legado
# assumia 20 e deixava as inexistentes falharem em silencio.
checkpoint partition_reads:
    input:
        "fastq/{sample}abyss.fq",
    output:
        directory("partitions/{sample}"),
    params:
        script=SCRIPTS + "partition.py",
        chunk_size=100000,
    shell:
        "python {params.script} {input} {params.chunk_size} && "
        "mkdir -p {output} && mv {input}_* {output}/ 2>/dev/null || mkdir -p {output}"


def abyss_chunks(wildcards):
    directory = checkpoints.partition_reads.get(**wildcards).output[0]
    chunks = glob_wildcards(Path(directory) / "{sample}abyss.fq_{chunk}").chunk
    return expand(
        "abyss_chunks/{sample}_chunk{chunk}/{sample}_chunk{chunk}-unitigs.fa",
        sample=wildcards.sample, chunk=sorted(chunks, key=int),
    )


rule assemble_soap:
    input:
        reads="fastq/{sample}_1_sequence.txt",
    output:
        contig="soap_out/{sample}_soap.contig",
        config="soap_config/{sample}_soap.config",
    params:
        soap=TOOLS["soapdenovo"],
        kmer=cfg["params.kmers.soap"],
        prefix=lambda w: f"soap_out/{w.sample}_soap",
    log:
        "logs/soap_{sample}.log",
    shell:
        "mkdir -p soap_config soap_out && "
        "printf 'max_rd_len=500\n[LIB]\nnreverse_seq=0\nasm_flags=3\nrank=1\nq=%s\n' "
        "$(realpath {input.reads}) > {output.config} && "
        "{params.soap} all -K {params.kmer} -s {output.config} -R -o {params.prefix} "
        "> {log} 2>&1"


rule assemble_metavelvet:
    input:
        reads="fastq/{sample}_1_sequence.txt",
    output:
        "velvet_{sample}/contigs.fa",
    params:
        velveth=TOOLS["velveth"],
        velvetg=TOOLS["velvetg"],
        meta_velvetg=TOOLS["meta_velvetg"],
        kmer=cfg["params.kmers.metavelvet"],
        outdir=lambda w: f"velvet_{w.sample}/",
    log:
        "logs/metavelvet_{sample}.log",
    shell:
        "({params.velveth} {params.outdir} {params.kmer} -short -fastq {input.reads} && "
        "{params.velvetg} {params.outdir} -exp_cov auto && "
        "{params.meta_velvetg} {params.outdir}) > {log} 2>&1"


rule assemble_abyss:
    input:
        "fastq/{sample}abyss.fq",
    output:
        "abyss_{sample}/{sample}-unitigs.fa",
    params:
        abyss=TOOLS["abyss_pe"],
        kmer=cfg["params.kmers.abyss"],
        outdir=lambda w: f"abyss_{w.sample}",
    log:
        "logs/abyss_{sample}.log",
    shell:
        "{params.abyss} -C {params.outdir} name={wildcards.sample} k={params.kmer} "
        "se=$(realpath {input}) > {log} 2>&1"


rule assemble_abyss_chunk:
    input:
        "partitions/{sample}/{sample}abyss.fq_{chunk}",
    output:
        "abyss_chunks/{sample}_chunk{chunk}/{sample}_chunk{chunk}-unitigs.fa",
    params:
        abyss=TOOLS["abyss_pe"],
        kmer=cfg["params.kmers.abyss"],
        outdir=lambda w: f"abyss_chunks/{w.sample}_chunk{w.chunk}",
    log:
        "logs/abyss_{sample}_chunk{chunk}.log",
    shell:
        "{params.abyss} -C {params.outdir} name={wildcards.sample}_chunk{wildcards.chunk} "
        "k={params.kmer} se=$(realpath {input}) > {log} 2>&1"


rule combine_abyss_chunks:
    input:
        abyss_chunks,
    output:
        "contig_individual/{sample}_a.contig",
    shell:
        "cat {input} > {output}"


rule collect_contigs:
    input:
        soap="soap_out/{sample}_soap.contig",
        velvet="velvet_{sample}/contigs.fa",
        abyss="abyss_{sample}/{sample}-unitigs.fa",
    output:
        soap="contig_individual/{sample}_S.contig",
        velvet="contig_individual/{sample}_V.contig",
        abyss="contig_individual/{sample}_A.contig",
    shell:
        "cp {input.soap} {output.soap} && cp {input.velvet} {output.velvet} && "
        "cp --dereference {input.abyss} {output.abyss}"


# Ordem S, V, A, a preservada: a concatenacao decide qual contig o CAP3 encontra
# primeiro, e trocar a ordem muda o consenso.
rule combine_contigs:
    input:
        soap="contig_individual/{sample}_S.contig",
        velvet="contig_individual/{sample}_V.contig",
        abyss="contig_individual/{sample}_A.contig",
        partitioned="contig_individual/{sample}_a.contig",
    output:
        "fastq/{sample}_contig2",
    params:
        script=SCRIPTS + "faLenFilter.py",
        min_length=cfg["params.contig_length_pre_cap3"],
        merged=lambda w: f"fastq/{w.sample}_contig",
    shell:
        "cat {input.soap} {input.velvet} {input.abyss} {input.partitioned} > {params.merged} && "
        "python {params.script} {params.merged} {output} {params.min_length}"


rule cap3_consensus:
    input:
        "fastq/{sample}_contig2",
    output:
        contigs="fastq/{sample}_contig2.cap.contigs",
        singlets="fastq/{sample}_contig2.cap.singlets",
    params:
        cap3=TOOLS["cap3"],
        overlap=25,
        identity=80,
    log:
        "logs/cap3_{sample}.log",
    shell:
        "{params.cap3} {input} -o {params.overlap} -p {params.identity} > {log} 2>&1"


rule assembled_contigs:
    input:
        contigs="fastq/{sample}_contig2.cap.contigs",
        singlets="fastq/{sample}_contig2.cap.singlets",
    output:
        "fastq/{sample}_contig4",
    params:
        script=SCRIPTS + "faLenFilter.py",
        min_length=cfg["params.contig_length_post_cap3"],
        merged=lambda w: f"fastq/{w.sample}_contig3",
        label=lambda w: f"{LIB}_{w.sample}",
    shell:
        "cat {input.singlets} {input.contigs} > {params.merged} && "
        "python {params.script} {params.merged} {output} {params.min_length} {params.label}"
