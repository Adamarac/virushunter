# Receita do pipeline: descreve cada etapa e de quais arquivos ela depende.
# O Snakemake le isto, descobre a ordem das etapas e executa o que falta.

import re
import sys

from snakemake.exceptions import WorkflowError
from pathlib import Path

sys.path.insert(0, str(Path(workflow.basedir).parent / "src"))

from virushunter.config import load as load_config
from virushunter.workflow import discover_samples, fastq_files, resolve_config

cfg = resolve_config(config, workflow.basedir)

SAMPLES = discover_samples(cfg["io.fastq_dir"])
FASTQ = fastq_files(cfg["io.fastq_dir"])
SPLITS = list(range(cfg["compute.query_splits"]))
LIB = cfg["io.library_prefix"]

PAIRS = ["1", "2"] if cfg["steps.paired_end"] else ["1"]
REMOVE_ADAPTOR = cfg["steps.remove_adaptor"]
NR_FILTER_METHOD = cfg["steps.nr_filter_method"]
BUSCA_DNA = cfg["steps.viral_search.nucleotide"]
SO_DIAMOND = cfg["steps.viral_search.diamond_only"]
SO_CONTIGS = cfg["steps.skip_reads"]
ENTRADA_FASTA = cfg["steps.input.from_fasta"]
DEDUP = cfg["steps.dedup"]
FAGO = cfg["steps.viral_search.phage"] == "True"
CLARK = cfg["steps.clark"]
ROTA_NT = cfg["steps.nt_route"]
if CLARK and ROTA_NT:
    raise WorkflowError(
        "clark e nt_route escrevem a mesma contagem por taxon e nao podem rodar juntas. "
        "No gerador antigo uma sobrescrevia a outra em silencio; escolha uma."
    )
CLARK_DBS = list(range(1, cfg["databases.clark_db_count"] + 1))
NT_INDICES = list(range(1, cfg["databases.nt_index_count"] + 1))

# O filtro de hospedeiro alinha contra um conjunto de indices: o 0 e o humano e os
# seguintes sao as bacterias. Quais entram depende do que se quer descartar.
_manter_humano = cfg["steps.host_filter.keep_human"]
_manter_bacteria = cfg["steps.host_filter.keep_bacteria"]
_n_bacterias = cfg["databases.bacteria_index_count"]
if _manter_humano and _manter_bacteria:
    raise WorkflowError(
        "keep_human e keep_bacteria ambos verdadeiros: nao sobra nada para filtrar. "
        "O gerador antigo quebrava neste caso; escolha um dos dois."
    )
elif _manter_humano:
    HOST_INICIO, HOST_FIM = 1, _n_bacterias
elif _manter_bacteria:
    HOST_INICIO, HOST_FIM = 0, 0
else:
    HOST_INICIO, HOST_FIM = 0, _n_bacterias
HOST_INDICES = list(range(HOST_INICIO, HOST_FIM + 1))


def indice_do_hospedeiro(n):
    """O indice 0 e o genoma humano; de 1 em diante sao os das bacterias."""
    n = int(n)
    if n == 0:
        return DB["human_bowtie_index"]
    return f"{DB['bacteria_bowtie_prefix']}{n}"
FILTRO_NR = cfg["steps.nr_filter"]
BANCOS_DE_SAIDA = cfg["steps.output.blast_databases"]
COPIAR_FASTQ = cfg["steps.output.copy_fastq"]
FUNDIR_PARES = cfg["steps.merge_pairs"]
ENTRADA_BAM = cfg["steps.input.from_bam"]
PREPARAR_SRA = cfg["steps.input.sra_prep"]
REMONTAR = cfg["steps.reassemble"]
if REMONTAR and cfg["steps.assembly.mode"] == "no":
    raise WorkflowError(
        "reassemble parte dos contigs de cada amostra, entao exige montagem ligada. "
        "Use junto com a rota denovo."
    )


def etiqueta_sra(indice_amostra, par):
    """Codigo sintetico por amostra, no formato <par>:N:0:<6-mer>, como no original."""
    import itertools
    kmers = ["".join(p) for p in itertools.product("ACGT", repeat=6)]
    return f"{par}:N:0:{kmers[indice_amostra]}"
if FUNDIR_PARES and cfg["steps.paired_end"]:
    raise WorkflowError(
        "merge_pairs com paired_end nao faz sentido: depois de fundido o par vira um "
        "arquivo so. O gerador antigo estourava com IndexError aqui (K33); desligue um."
    )

DB = cfg.get("databases")
PROJETO = Path(workflow.basedir).parent


def caminho_do_projeto(valor):
    """Nome simples fica como esta e e procurado no PATH; caminho vira absoluto."""
    if not valor or ("/" not in valor and "\\" not in valor):
        return valor
    caminho = Path(valor)
    if not caminho.is_absolute():
        caminho = PROJETO / caminho
    return str(caminho)


TOOLS = {nome: caminho_do_projeto(valor) for nome, valor in cfg.get("tools").items()}
SCRIPTS = caminho_do_projeto(cfg["tools.scripts_dir"]).rstrip("/\\") + "/"
WEB = str(PROJETO / "web") + "/"

# Chaves que a configuracao oferece mas o workflow ainda nao implementa. Mudar uma
# delas nao teria efeito nenhum, entao o pipeline para aqui em vez de enganar.
NAO_IMPLEMENTADO = {
    "steps.hmmer": False,
}
_mudadas = [k for k, padrao in NAO_IMPLEMENTADO.items() if cfg.get(k, padrao) != padrao]
if _mudadas:
    raise WorkflowError(
        "Estas chaves ainda nao foram migradas para o workflow, entao mudar o valor "
        "delas nao surtiria efeito: " + ", ".join(_mudadas)
        + ". Veja docs/routes.md e volte-as ao valor padrao para continuar."
    )


wildcard_constraints:
    sample="|".join(re.escape(s) for s in SAMPLES),
    split=r"\d+",
    idx=r"\d+",


# Os arquivos que o pipeline deve produzir no final; tudo o mais e feito para chegar aqui.
def alvos_finais():
    """Os arquivos que o pipeline deve produzir; as rotas opcionais acrescentam os seus."""
    alvos = [
        *expand("blast_filter_out/{sample}_blast_filter.html", sample=SAMPLES),
        "blast_filter_out/all_blast_filter.html",
        "report/hitTable",
        "report/index.html",
        *expand("report/pie/{sample}_blast_filter.png", sample=SAMPLES),
        "report/.published",
    ]
    if CLARK or ROTA_NT:
        alvos += expand("report/clark/{sample}.html", sample=SAMPLES)
    if BANCOS_DE_SAIDA:
        alvos.append("report/blast/report_blastdb.nal")
    if COPIAR_FASTQ:
        alvos.append("report/fastq/.copiado")
    if PREPARAR_SRA:
        alvos.append("sra.fq.gz")
    if REMONTAR:
        alvos.append("report/reAssemble/tally.txt")
    return alvos


rule all:
    input:
        alvos_finais(),


if COPIAR_FASTQ:

    # Guarda uma copia das leituras originais junto do relatorio.
    rule copy_fastq:
        input:
            expand("fastq/{sample}_{pair}.fil", sample=SAMPLES, pair=PAIRS),
        output:
            touch("report/fastq/.copiado"),
        shell:
            "mkdir -p report/fastq && cp -r fastq/*.fastq* report/fastq/ 2>/dev/null || true"


if FUNDIR_PARES:

    # Funde as duas leituras de um mesmo fragmento numa sequencia so, quando elas se
    # sobrepoem. O que sobra segue como leitura unica.
    rule merge_pairs:
        input:
            r1=lambda w: FASTQ[(w.sample, "1")],
            r2=lambda w: FASTQ[(w.sample, "2")],
        output:
            fundidas=temp("fastq/{sample}.extendedFrags.fastq"),
            sobra1=temp("fastq/{sample}.notCombined_1.fastq"),
            sobra2=temp("fastq/{sample}.notCombined_2.fastq"),
        params:
            flash=TOOLS["flash"],
            max_overlap=cfg["params.flash_max_overlap"],
            saida="fastq/",
        threads: cfg["compute.threads"]
        shell:
            "{params.flash} -M {params.max_overlap} -t {threads} -o {wildcards.sample} "
            "-d {params.saida} {input.r1} {input.r2}"

    # O que sobrou sem fundir volta para a mesma pilha, como leitura unica.
    rule merge_pairs_join:
        input:
            fundidas="fastq/{sample}.extendedFrags.fastq",
            sobra1="fastq/{sample}.notCombined_1.fastq",
            sobra2="fastq/{sample}.notCombined_2.fastq",
        output:
            "fastq/{sample}_flash.fq",
        shell:
            "cat {input.sobra1} {input.sobra2} {input.fundidas} > {output}"


if ENTRADA_BAM:

    # Entrada em BAM: o picard extrai as leituras antes de tudo.
    rule bam_to_fastq:
        input:
            "fastq/{sample}_{pair}.bam",
        output:
            "fastq/{sample}_{pair}.fastq",
        params:
            picard=TOOLS["picard"],
        shell:
            "{params.picard} SamToFastq INPUT={input} FASTQ={output} "
            "VALIDATION_STRINGENCY=SILENT"


if PREPARAR_SRA:

    # Junta tudo num arquivo so, reetiquetado para submissao ao SRA. E uma tarefa
    # unica de proposito: o script acrescenta ao mesmo arquivo, entao jobs em
    # paralelo se atropelariam.
    rule prepare_sra:
        input:
            [FASTQ[(s, p)] for s in SAMPLES for p in PAIRS],
        output:
            "sra.fq.gz",
        params:
            script=SCRIPTS + "reads/tag_for_sra.py",
            etiquetas=[etiqueta_sra(i, p)
                       for i, s in enumerate(SAMPLES, start=1) for p in PAIRS],
        run:
            shell("rm -f {output}")
            for entrada, etiqueta in zip(input, params.etiquetas):
                shell("python {params.script} %s %s {output}" % (entrada, etiqueta))


if ENTRADA_FASTA:

    # Quando a entrada vem em FASTA, sem qualidade, converte antes de comecar.
    rule fasta_to_fastq:
        input:
            "fasta/{sample}_{pair}.fa",
        output:
            "fastq/{sample}_{pair}.fastq",
        params:
            script=SCRIPTS + "reads/fasta_to_fastq.py",
        shell:
            "python {params.script} {input} {output}"


# Compara as leituras com o genoma do hospedeiro (humano, mosquito etc.).
rule host_align:
    input:
        fastq=lambda w: ("fastq/%s_flash.fq" % w.sample) if FUNDIR_PARES
        else FASTQ[(w.sample, w.pair)],
    output:
        sam=temp("fastq/{sample}_{pair}_{idx}.sam"),
    params:
        index=lambda w: indice_do_hospedeiro(w.idx),
        bowtie2=TOOLS["bowtie2"],
    threads: cfg["compute.threads"]
    shell:
        "{params.bowtie2} --quiet --local --very-fast-local --no-hd --reorder "
        "-p {threads} -x {params.index} -U {input.fastq} -S {output.sam}"


# Leituras que sao do hospedeiro nao interessam, mas em vez de apagar a gente
# apaga so o conteudo e mantem a linha vazia: a posicao de cada leitura e a
# identidade dela, entao remover linhas embaralharia tudo.
rule host_filter:
    input:
        sams=expand("fastq/{{sample}}_{pair}_{idx}.sam", pair=PAIRS, idx=HOST_INDICES),
    output:
        filtered=expand("fastq/{{sample}}_{pair}.fil", pair=PAIRS),
    params:
        script=SCRIPTS + "reads/host_mask.py",
        prefix=lambda w: f"fastq/{w.sample}",
        inicio=HOST_INICIO,
        fim=HOST_FIM,
    shell:
        "python {params.script} {params.prefix} {params.inicio} {params.fim} "
        "{output.filtered}"


# Sem dedup, o estagio seguinte consome o .fil direto e esta regra nem existe.
LEITURAS_LIMPAS = "fastq/{sample}_{pair}.dup" if DEDUP else "fastq/{sample}_{pair}.fil"

if DEDUP:

    # Copias identicas da mesma leitura sao lixo de PCR; sao esvaziadas, nao removidas.
    rule dedup:
        input:
            "fastq/{sample}_{pair}.fil",
        output:
            LEITURAS_LIMPAS,
        params:
            script=SCRIPTS + "reads/dedup.py",
        shell:
            "python {params.script} {input} {output}"


if not REMOVE_ADAPTOR:


    # Da a cada leitura um nome curto baseado na posicao dela no arquivo.
    rule recode_ids:
        input:
            LEITURAS_LIMPAS,
        output:
            "fastq/{sample}_{pair}.trim",
        params:
            script=SCRIPTS + "reads/rename_reads.py",
            label=lambda w: f"{LIB}_{w.sample}",
        shell:
            "python {params.script} {input} {output} {params.label} {wildcards.pair}"

else:


    # Converte as leituras para o formato que a busca por adaptadores exige.
    rule reads_to_fasta_for_adaptor:
        input:
            LEITURAS_LIMPAS,
        output:
            "fastq/{sample}_{pair}.fa",
        params:
            script=SCRIPTS + "reads/to_fasta_positional.py",
        shell:
            "python {params.script} {input} {wildcards.sample}_{wildcards.pair} {output}"


    # Prepara as leituras para poderem ser pesquisadas rapidamente.
    rule adaptor_blastdb:
        input:
            "fastq/{sample}_{pair}.fa",
        output:
            multiext("blast_filter_out/blast2/{sample}_{pair}_blastdb", ".nhr", ".nin", ".nsq"),
        params:
            prefix=lambda w: f"blast_filter_out/blast2/{w.sample}_{w.pair}_blastdb",
            makeblastdb=TOOLS["makeblastdb"],
        log:
            "logs/adaptor_blastdb_{sample}_{pair}.log",
        shell:
            "mkdir -p blast_filter_out/blast2 && "
            "{params.makeblastdb} -dbtype nucl -parse_seqids -in {input} -out {params.prefix} "
            "> {log} 2>&1"

    # Procura pedacos de adaptador dentro das leituras. Aqui a busca e invertida:
    # o adaptador e o que se procura e as leituras sao onde se procura.
    rule find_adaptors:
        input:
            db="blast_filter_out/blast2/{sample}_{pair}_blastdb.nhr",
        output:
            "fastq/{sample}_{pair}.tab",
        params:
            blastn=TOOLS["blastn"],
            adaptors=SCRIPTS + "reads/adaptor.fa",
            prefix=lambda w: f"blast_filter_out/blast2/{w.sample}_{w.pair}_blastdb",
        threads: cfg["compute.threads"]
        shell:
            "{params.blastn} -task blastn -evalue 1 -max_target_seqs 100000000 "
            "-outfmt '6 qseqid sseqid evalue qstart qend sstart send' "
            "-query {params.adaptors} -num_threads {threads} "
            "-db {params.prefix} -out {output}"


    # Corta fora os pedacos de adaptador que a busca encontrou.
    rule trim_adaptors:
        input:
            reads=LEITURAS_LIMPAS,
            hits="fastq/{sample}_{pair}.tab",
        output:
            "fastq/{sample}_{pair}.ada",
        params:
            script=SCRIPTS + "reads/trim_adaptors.py",
            label=lambda w: f"{LIB}_{w.sample}",
        shell:
            "python {params.script} {input.reads} {input.hits} {output} "
            "{params.label} {wildcards.pair}"


    # Corta o final da leitura, onde o sequenciador costuma errar mais.
    rule trim_quality:
        input:
            trimmed="fastq/{sample}_{pair}.ada",
            raw=lambda w: FASTQ[(w.sample, w.pair)],
        output:
            "fastq/{sample}_{pair}.trim",
        params:
            script=SCRIPTS + "reads/trim_quality.py",
            phred_offset=33,
            phred=10,
            skip_front=cfg["params.quality_skip_front"],
        shell:
            "python {params.script} {input.trimmed} {output} {params.phred_offset} "
            "{input.raw} {params.phred} {params.skip_front}"


# Joga fora leituras curtas demais para servir. E aqui que as leituras esvaziadas
# nas etapas anteriores finalmente somem.
rule length_filter:
    input:
        expand("fastq/{{sample}}_{pair}.trim", pair=PAIRS),
    output:
        expand("fastq/{{sample}}_{pair}_sequence.txt", pair=PAIRS),
    params:
        script=SCRIPTS + "reads/filter_pairs.py",
        min_length=5,
    shell:
        "python {params.script} {input} {output} {params.min_length}"


# Junta num arquivo so todas as leituras da amostra.
rule reads_to_fastq:
    input:
        expand("fastq/{{sample}}_{pair}_sequence.txt", pair=PAIRS),
    output:
        "fastq/{sample}.fq",
    shell:
        "cat {input} > {output}"


# Converte para o formato usado nas buscas, descartando o que ficou curto.
rule reads_to_fasta:
    input:
        "fastq/{sample}.fq",
    output:
        "fastq/{sample}.fa",
    params:
        script=SCRIPTS + "reads/to_fasta.py",
        min_length=cfg["params.min_read_length"],
    shell:
        "python {params.script} {input} {output} {params.min_length}"


def query_parts(wildcards):
    """O que entra na busca: leituras soltas, contigs montados, ou so os contigs."""
    montou = cfg["steps.assembly.mode"] != "no"
    if montou and SO_CONTIGS:
        return [f"fastq/{wildcards.sample}_contig4"]
    parts = [f"fastq/{wildcards.sample}.fa"]
    if montou:
        parts.insert(0, f"fastq/{wildcards.sample}_contig4")
    return parts


# Monta o conjunto que sera pesquisado. Se a montagem estiver ligada, os trechos
# montados entram junto com as leituras soltas.
rule build_query:
    input:
        query_parts,
    output:
        "fastq/{sample}_c",
    shell:
        "cat {input} > {output}"


# Divide o material em pedacos para que a busca rode em paralelo e termine antes.
rule split_query:
    input:
        "fastq/{sample}_c",
    output:
        expand("fastq/{{sample}}_c_{split}", split=SPLITS),
    params:
        script=SCRIPTS + "search/split_fasta.py",
        n=cfg["compute.query_splits"],
    shell:
        "python {params.script} {input} {params.n}"


# A busca viral tem tres formas, escolhidas em steps.viral_search.
if SO_DIAMOND:

    # Busca por DIAMOND, que e muito mais rapido que o blastx.
    rule blast_virus_diamond:
        input:
            "fastq/{sample}_c_{split}",
        output:
            temp("blast_virus_out/{sample}_blast.xml_{split}.pre"),
        params:
            diamond=TOOLS["diamond"],
            db=DB["diamond_virus"],
            evalue=cfg["params.evalue"],
        threads: cfg["compute.threads"]
        shell:
            "{params.diamond} blastx -d {params.db} --quiet --sensitive --threads {threads} "
            "--evalue {params.evalue} --max-target-seqs 1 --outfmt 5 -q {input} -o {output}"

    # O XML que o DIAMOND emite precisa de conserto antes de ser lido.
    rule fix_diamond_xml:
        input:
            "blast_virus_out/{sample}_blast.xml_{split}.pre",
        output:
            "blast_virus_out/{sample}_blast.xml_{split}",
        params:
            script=SCRIPTS + "search/fix_diamond_xml.py",
        shell:
            "python {params.script} {input} {output}"

elif BUSCA_DNA:

    # Busca comparando DNA contra o banco de genomas virais, em vez de proteina.
    rule blast_virus:
        input:
            "fastq/{sample}_c_{split}",
        output:
            "blast_virus_out/{sample}_blast.xml_{split}",
        params:
            blastn=TOOLS["blastn"],
            db=DB["virus_dna"],
            evalue=cfg["params.evalue"],
        threads: cfg["compute.threads"]
        shell:
            "{params.blastn} -num_threads {threads} -evalue {params.evalue} -outfmt 5 "
            "-dbsize 10000000 -searchsp 1000000000 -max_target_seqs 1 "
            "-db_soft_mask 11 -best_hit_overhang 0.1 -best_hit_score_edge 0.1 "
            "-db {params.db} -query {input} -out {output}"

else:

    # O coracao do pipeline: procura semelhanca com proteinas de virus conhecidos.
    rule blast_virus:
        input:
            "fastq/{sample}_c_{split}",
        output:
            "blast_virus_out/{sample}_blast.xml_{split}",
        params:
            blastx=TOOLS["blastx"],
            db=DB["phage"] if FAGO else DB["virus_protein"],
            evalue=cfg["params.evalue"],
        threads: cfg["compute.threads"]
        shell:
            "{params.blastx} -num_threads {threads} -evalue {params.evalue} -outfmt 5 "
            "-dbsize 10000000 -searchsp 1000000000 -max_target_seqs 1 "
            "-db_soft_mask 21 -best_hit_overhang 0.1 -best_hit_score_edge 0.1 "
            "-db {params.db} -query {input} -out {output}"


# Separa o que pareceu viral do que nao pareceu nada conhecido.
rule parse_virus_hits:
    input:
        xml="blast_virus_out/{sample}_blast.xml_{split}",
        query="fastq/{sample}_c_{split}",
    output:
        significant="fastq/{sample}_c_{split}_s",
        mystery="blast_filter_out/tmp/{sample}_prem.fasta_{split}",
    params:
        script=SCRIPTS + "search/parse_hits.py",
        myslen=cfg["params.mystery_min_length"],
        evalue=cfg["params.evalue"],
        log="blast_virus.log",
    shell:
        "python {params.script} {input.xml} {input.query} {output.significant} "
        "{output.mystery} {params.myslen} {params.evalue} {params.log}"


# Junta os candidatos a virus vindos de todos os pedacos.
rule merge_significant:
    input:
        expand("fastq/{{sample}}_c_{split}_s", split=SPLITS),
    output:
        "fastq/{sample}_sig",
    shell:
        "cat {input} > {output}"


# Compara os candidatos com um banco de tudo que nao e virus. Se a sequencia se
# parece mais com uma bacteria do que com um virus, provavelmente nao e virus.
# Ha dois metodos, escolhidos em steps.nr_filter_method.
if NR_FILTER_METHOD == "diamond":

    # Metodo rapido: o DIAMOND diz qual e o parente mais proximo de cada candidato.
    rule diamond_nr:
        input:
            "fastq/{sample}_sig",
        output:
            "diamond_nr_out/{sample}.m8",
        params:
            diamond=TOOLS["diamond"],
            db=DB["diamond_nr"],
            evalue=cfg["params.evalue"],
        threads: cfg["compute.threads"]
        shell:
            "{params.diamond} blastx --quiet --threads {threads} --evalue {params.evalue} "
            "--max-target-seqs 1 --outfmt 6 "
            "-d {params.db} -q {input} -o {output}"

else:

    # Metodo lento: busca completa contra o banco nao viral, que devolve o quanto
    # cada semelhanca foi boa e nao apenas quem foi o parente mais proximo.
    rule blastx_nr:
        input:
            "fastq/{sample}_c_{split}_s",
        output:
            "blast_nr_out/{sample}_nr.xml_{split}",
        params:
            blastx=TOOLS["blastx"],
            db=DB["non_viral_nr"],
            evalue=cfg["params.evalue"],
        threads: cfg["compute.threads"]
        shell:
            "{params.blastx} -num_threads {threads} -evalue {params.evalue} -outfmt 5 "
            "-dbsize 10000000 -searchsp 1000000000 -max_target_seqs 1 "
            "-best_hit_overhang 0.1 -best_hit_score_edge 0.1 "
            "-db {params.db} -query {input} -out {output}"


def resultado_do_nr(wildcards):
    """Onde esta a busca contra o NR: um .m8 por amostra, ou um XML por fatia."""
    if NR_FILTER_METHOD == "diamond":
        return f"diamond_nr_out/{wildcards.sample}.m8"
    return f"blast_nr_out/{wildcards.sample}_nr.xml_{wildcards.split}"


# Descarta os candidatos que se pareceram mais com algo nao viral. O mesmo script
# atende aos dois metodos; so muda de onde vem o resultado da busca.
rule filter_against_nr:
    input:
        xml="blast_virus_out/{sample}_blast.xml_{split}",
        nr=resultado_do_nr,
        query="fastq/{sample}_c_{split}",
    output:
        "blast_filter_out/{sample}_blast_filter.txt_{split}",
    params:
        script=SCRIPTS + "search/filter_nr.py",
        metodo=NR_FILTER_METHOD,
        evalue=cfg["params.evalue"],
        hsp=cfg["params.hsp_only"],
    shell:
        "python {params.script} {input.xml} {input.nr} {input.query} {output} "
        "{params.evalue} {params.hsp} {params.metodo}"


# Junta os pedacos de volta. Funciona porque cada resultado ocupa sempre o mesmo
# numero de linhas, entao da para colar os arquivos sem embaralhar nada.
rule merge_filtered:
    input:
        expand("blast_filter_out/{{sample}}_blast_filter.txt_{split}", split=SPLITS),
    output:
        "blast_filter_out/{sample}_blast_filter.txt",
    shell:
        "cat {input} > {output}"


# Reune o resultado final de todas as amostras num arquivo so.
rule merge_all_samples:
    input:
        expand("blast_filter_out/{sample}_blast_filter.txt", sample=SAMPLES),
    output:
        "blast_filter_out/all_blast_filter.txt",
    shell:
        "cat {input} > {output}"


# Reune o que nao se pareceu com nada conhecido: os candidatos a virus novo.
rule merge_mystery:
    input:
        expand("blast_filter_out/tmp/{{sample}}_prem.fasta_{split}", split=SPLITS),
    output:
        "report/mystery/{sample}_m.fasta",
    shell:
        "cat {input} > {output}"


# Reune os candidatos a virus novo de todas as amostras.
rule merge_mystery_all:
    input:
        expand("report/mystery/{sample}_m.fasta", sample=SAMPLES),
    output:
        "report/mystery/all_m.fasta.out",
    shell:
        "cat {input} > {output}"


# Monta o relatorio da amostra: agrupa os achados por especie de virus.
rule report_sample:
    input:
        filtered="blast_filter_out/{sample}_blast_filter.txt",
        reads="fastq/{sample}.fa",
        mystery="report/mystery/{sample}_m.fasta",
    output:
        summary="blast_filter_out/{sample}_blast_filter.html",
        excel="blast_filter_out/{sample}_blast_filter.xls",
        pie="blast_filter_out/pie/{sample}_blast_filter.txt",
        table="blast_filter_out/table/{sample}_blast_filter.txt",
        masked="report/mystery/{sample}_m_complex.fasta",
        sorted_mystery="report/mystery/{sample}_m_complex_sort.fasta",
    params:
        script=SCRIPTS + "report/build_report.py",
        fasort=SCRIPTS + "report/sort_by_length.py",
        dustmasker=TOOLS["dustmasker"],
        scripts_dir=SCRIPTS + "report/",
        base="report",
    log:
        "logs/report_{sample}.log",
    shell:
        "python {params.script} {input.filtered} {input.reads} {params.scripts_dir} "
        "{params.base} {params.base} > {log} 2>&1 && "
        "{params.dustmasker} -in {input.mystery} -infmt fasta -outfmt fasta "
        "-out {output.masked} && "
        "python {params.fasort} {output.masked} {output.sorted_mystery} True"


# Mesmo relatorio, mas somando todas as amostras de uma vez.
rule report_all:
    input:
        filtered="blast_filter_out/all_blast_filter.txt",
        mystery="report/mystery/all_m.fasta.out",
        per_sample=expand("blast_filter_out/{sample}_blast_filter.html", sample=SAMPLES),
    output:
        summary="blast_filter_out/all_blast_filter.html",
        excel="blast_filter_out/all_blast_filter.xls",
        pie="blast_filter_out/pie/all_blast_filter.txt",
        table="blast_filter_out/table/all_blast_filter.txt",
        masked="report/mystery/all_m_complex.fasta",
        sorted_mystery="report/mystery/all_m_complex_sort.fasta",
    params:
        script=SCRIPTS + "report/build_report.py",
        fasort=SCRIPTS + "report/sort_by_length.py",
        dustmasker=TOOLS["dustmasker"],
        scripts_dir=SCRIPTS + "report/",
        base="report",
    log:
        "logs/report_all.log",
    shell:
        "python {params.script} {input.filtered} -- {params.scripts_dir} "
        "{params.base} {params.base} > {log} 2>&1 && "
        "{params.dustmasker} -in {input.mystery} -infmt fasta -outfmt fasta "
        "-out {output.masked} && "
        "python {params.fasort} {output.masked} {output.sorted_mystery}"


# Junta as tabelas de cada amostra numa tabela unica.
rule merge_table:
    input:
        all_table="blast_filter_out/table/all_blast_filter.txt",
        per_sample=expand("blast_filter_out/table/{sample}_blast_filter.txt", sample=SAMPLES),
    output:
        "report/hitTable",
    params:
        script=SCRIPTS + "report/merge_tables.py",
    shell:
        "python {params.script} {input.all_table} {input.per_sample} {output}"


# Grafico de pizza mostrando quanto de cada familia de virus apareceu.
rule plot_pie:
