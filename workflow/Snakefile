ASSEMBLY = cfg["steps.assembly.mode"]


# O ABySS pede um corte de tamanho proprio, diferente do usado no resto.
rule prepare_abyss_reads:
    input:
        "fastq/{sample}.fq",
    output:
        "fastq/{sample}abyss.fq",
    params:
        script=SCRIPTS + "assembly/filter_fastq_length.py",
        min_length=35,
    shell:
        "python {params.script} {input} {output} {params.min_length}"


# Divide as leituras em lotes. Quantos lotes serao so da para saber na hora,
# porque depende do tamanho da amostra.
checkpoint partition_reads:
    input:
        "fastq/{sample}abyss.fq",
    output:
        directory("partitions/{sample}"),
    params:
        script=SCRIPTS + "assembly/split_fastq.py",
        chunk_size=100000,
    shell:
        "python {params.script} {input} {params.chunk_size} && "
        "mkdir -p {output} && mv {input}_* {output}/ 2>/dev/null || mkdir -p {output}"


def abyss_chunks(wildcards):
    directory = checkpoints.partition_reads.get(**wildcards).output[0]
    chunks = glob_wildcards(Path(directory) / "{sample}abyss.fq_{chunk}").chunk
    return expand(
        "abyss_chunks/{sample}_chunk{chunk}/{sample}_chunk{chunk}-unitigs.fa",
        sample=wildcards.sample, chunk=sorted(chunks, key=int),
    )


# Tenta remontar sequencias maiores juntando leituras que se sobrepoem (SOAPdenovo2).
rule assemble_soap:
    input:
        reads="fastq/{sample}_1_sequence.txt",
    output:
        contig="soap_out/{sample}_soap.contig",
        config="soap_config/{sample}_soap.config",
    params:
        soap=TOOLS["soapdenovo"],
        kmer=cfg["params.kmers.soap"],
        prefix=lambda w: f"soap_out/{w.sample}_soap",
    log:
        "logs/soap_{sample}.log",
    shell:
        "mkdir -p soap_config soap_out && "
        "printf 'max_rd_len=500\n[LIB]\nnreverse_seq=0\nasm_flags=3\nrank=1\nq=%s\n' "
        "$(realpath {input.reads}) > {output.config} && "
        "{params.soap} all -K {params.kmer} -s {output.config} -R -o {params.prefix} "
        "> {log} 2>&1"


# A mesma remontagem, por outro programa (MetaVelvet).
rule assemble_metavelvet:
    input:
        reads="fastq/{sample}_1_sequence.txt",
    output:
        "velvet_{sample}/contigs.fa",
    params:
        velveth=TOOLS["velveth"],
        velvetg=TOOLS["velvetg"],
        meta_velvetg=TOOLS["meta_velvetg"],
        kmer=cfg["params.kmers.metavelvet"],
        outdir=lambda w: f"velvet_{w.sample}/",
    log:
        "logs/metavelvet_{sample}.log",
    shell:
        "({params.velveth} {params.outdir} {params.kmer} -short -fastq {input.reads} && "
        "{params.velvetg} {params.outdir} -exp_cov auto && "
        "{params.meta_velvetg} {params.outdir}) > {log} 2>&1"


# A mesma remontagem, por um terceiro programa (ABySS), na amostra inteira.
rule assemble_abyss:
    input:
        "fastq/{sample}abyss.fq",
    output:
        "abyss_{sample}/{sample}-unitigs.fa",
    params:
        abyss=TOOLS["abyss_pe"],
        kmer=cfg["params.kmers.abyss"],
        outdir=lambda w: f"abyss_{w.sample}",
    log:
        "logs/abyss_{sample}.log",
    shell:
        "{params.abyss} -C {params.outdir} name={wildcards.sample} k={params.kmer} "
        "se=$(realpath {input}) > {log} 2>&1"


# ABySS de novo, agora em um lote por vez, para amostras grandes demais.
rule assemble_abyss_chunk:
    input:
        "partitions/{sample}/{sample}abyss.fq_{chunk}",
    output:
        "abyss_chunks/{sample}_chunk{chunk}/{sample}_chunk{chunk}-unitigs.fa",
    params:
        abyss=TOOLS["abyss_pe"],
        kmer=cfg["params.kmers.abyss"],
        outdir=lambda w: f"abyss_chunks/{w.sample}_chunk{w.chunk}",
    log:
        "logs/abyss_{sample}_chunk{chunk}.log",
    shell:
        "{params.abyss} -C {params.outdir} name={wildcards.sample}_chunk{wildcards.chunk} "
        "k={params.kmer} se=$(realpath {input}) > {log} 2>&1"


# Junta o que o ABySS montou em cada lote.
rule combine_abyss_chunks:
    input:
        abyss_chunks,
    output:
        "contig_individual/{sample}_a.contig",
    shell:
        "cat {input} > {output}"


# Reune o resultado dos tres programas de montagem.
rule collect_contigs:
    input:
        soap="soap_out/{sample}_soap.contig",
        velvet="velvet_{sample}/contigs.fa",
        abyss="abyss_{sample}/{sample}-unitigs.fa",
    output:
        soap="contig_individual/{sample}_S.contig",
        velvet="contig_individual/{sample}_V.contig",
        abyss="contig_individual/{sample}_A.contig",
    shell:
        "cp {input.soap} {output.soap} && cp {input.velvet} {output.velvet} && "
        "cp --dereference {input.abyss} {output.abyss}"


# A ordem em que os resultados sao colados importa: a etapa seguinte produz uma
# saida diferente se a ordem mudar. Por isso ela e fixa.
rule combine_contigs:
    input:
        soap="contig_individual/{sample}_S.contig",
        velvet="contig_individual/{sample}_V.contig",
        abyss="contig_individual/{sample}_A.contig",
        partitioned="contig_individual/{sample}_a.contig",
    output:
        "fastq/{sample}_contig2",
    params:
        script=SCRIPTS + "assembly/filter_contig_length.py",
        min_length=cfg["params.contig_length_pre_cap3"],
        merged=lambda w: f"fastq/{w.sample}_contig",
    shell:
        "cat {input.soap} {input.velvet} {input.abyss} {input.partitioned} > {params.merged} && "
        "python {params.script} {params.merged} {output} {params.min_length}"


# Junta os tres resultados de montagem numa versao final unica.
rule cap3_consensus:
    input:
        "fastq/{sample}_contig2",
    output:
        contigs="fastq/{sample}_contig2.cap.contigs",
        singlets="fastq/{sample}_contig2.cap.singlets",
    params:
        cap3=TOOLS["cap3"],
        overlap=25,
        identity=80,
    log:
        "logs/cap3_{sample}.log",
    shell:
        "{params.cap3} {input} -o {params.overlap} -p {params.identity} > {log} 2>&1"


# Junta o que foi montado com o que sobrou sozinho e aplica o corte de tamanho final.
rule assembled_contigs:
    input:
        contigs="fastq/{sample}_contig2.cap.contigs",
        singlets="fastq/{sample}_contig2.cap.singlets",
    output:
        "fastq/{sample}_contig4",
    params:
        script=SCRIPTS + "assembly/filter_contig_length.py",
        min_length=cfg["params.contig_length_post_cap3"],
        merged=lambda w: f"fastq/{w.sample}_contig3",
        label=lambda w: f"{LIB}_{w.sample}",
    shell:
        "cat {input.singlets} {input.contigs} > {params.merged} && "
        "python {params.script} {params.merged} {output} {params.min_length} {params.label}"


# Mede quantas repeticoes de uma mesma letra existem, antes da limpeza.
rule polya_raw:
    input:
        lambda w: FASTQ[(w.sample, w.pair)],
    output:
        data="report/hist/{sample}_{pair}_raw_hist.txt",
        rscript="report/hist/{sample}_{pair}_raw_hist.R",
    params:
        script=SCRIPTS + "report/homopolymer_hist.py",
        prefix=lambda w: f"report/hist/{w.sample}_{w.pair}",
    log:
        "logs/polya_raw_{sample}_{pair}.log",
    shell:
        "python {params.script} {input} {params.prefix} raw > {log} 2>&1"


# A mesma medida depois da limpeza, para comparar.
rule polya_clean:
    input:
        "fastq/{sample}_{pair}_sequence.txt",
    output:
        data="report/hist/{sample}_{pair}_clean_hist.txt",
        rscript="report/hist/{sample}_{pair}_clean_hist.R",
    params:
        script=SCRIPTS + "report/homopolymer_hist.py",
        prefix=lambda w: f"report/hist/{w.sample}_{w.pair}",
    log:
        "logs/polya_clean_{sample}_{pair}.log",
    shell:
        "python {params.script} {input} {params.prefix} clean > {log} 2>&1"


# Desenha o grafico dessa comparacao.
rule plot_histogram:
    input:
        "report/hist/{sample}_{pair}_{stage}_hist.R",
    output:
        "report/hist/{sample}_{pair}_{stage}_hist.png",
    params:
        rout=lambda w: f"report/hist/{w.sample}_{w.pair}_{w.stage}_hist.Rout",
    shell:
        "R CMD BATCH --quiet --vanilla {input} {params.rout}"


# Deixa a amostra pesquisavel, para quem quiser consultar depois.
rule sample_blastdb:
    input:
        "fastq/{sample}.fa",
    output:
        multiext("report/blast/{sample}_blastdb", ".nhr", ".nin", ".nsq"),
    params:
        prefix=lambda w: f"report/blast/{w.sample}_blastdb",
        makeblastdb=TOOLS["makeblastdb"],
    log:
        "logs/blastdb_{sample}.log",
    shell:
        "mkdir -p report/blast && "
        "{params.makeblastdb} -dbtype nucl -parse_seqids -in {input} -out {params.prefix} "
        "> {log} 2>&1"


# Agrupa as amostras para poderem ser pesquisadas todas de uma vez.
rule blastdb_alias:
    input:
        expand("report/blast/{sample}_blastdb.nhr", sample=SAMPLES),
    output:
        "report/blast/report_blastdb.nal",
    params:
        script=SCRIPTS + "report/blastdb_alias.py",
        aliastool=TOOLS["blastdb_aliastool"],
    log:
        "logs/blastdb_alias.log",
    shell:
        "python {params.script} report report/blast/ {params.aliastool} > {log} 2>&1"


if CLARK:

    # Classificacao taxonomica pelo CLARK, contra cada um dos bancos.
    rule clark_classify:
        input:
            "fastq/{sample}.fa",
        output:
            "clark_out/{sample}_clark{db}.csv",
        params:
            clark=TOOLS["clark"],
            alvo=lambda w: f"{DB['clark_target_prefix']}{w.db}.txt",
            banco=lambda w: f"{DB['clark_db_prefix']}{w.db}/",
            saida=lambda w: f"clark_out/{w.sample}_clark{w.db}",
        threads: cfg["compute.threads"]
        shell:
            "mkdir -p clark_out && {params.clark} -k 20 -n {threads} -T {params.alvo} "
            "-D {params.banco} -O {input} -R {params.saida}"

    # Junta a saida dos varios bancos numa tabela so.
    rule clark_merge:
        input:
            expand("clark_out/{{sample}}_clark{db}.csv", db=CLARK_DBS),
        output:
            "clark_out/{sample}.csvv",
        shell:
            "cat {input} > {output}"

    # Conta quantas leituras cairam em cada especie.
    rule clark_counts:
        input:
            csvv="clark_out/{sample}.csvv",
            reads="fastq/{sample}.fa",
        output:
            "report/clark/{sample}.count",
        params:
            script=SCRIPTS + "report/clark_counts.py",
            indice=DB["species_index"],
            base="report",
        shell:
            "mkdir -p report/clark && python {params.script} {params.indice} {input.csvv} "
            "{output} {input.reads} {params.base}"


if ROTA_NT:

    # Alinha contra os indices do banco nt, um por vez.
    rule nt_align:
        input:
            "fastq/{sample}.fa",
        output:
            temp("NT/{sample}_{idx}.sam"),
        params:
            bowtie2=TOOLS["bowtie2"],
            indice=lambda w: f"{DB['nt_bowtie_prefix']}{w.idx}",
        threads: cfg["compute.threads"]
        shell:
            "mkdir -p NT && {params.bowtie2} --quiet --local --very-fast-local --no-hd "
            "--reorder -p {threads} -x {params.indice} -f {input} -S {output}"

    # Conta as leituras por taxon a partir desses alinhamentos.
    # As contagens desta rota nao sao confiaveis, ver K2 em docs/known-issues.md.
    rule nt_counts:
        input:
            expand("NT/{{sample}}_{idx}.sam", idx=NT_INDICES),
        output:
            "report/clark/{sample}.count",
        params:
            script=SCRIPTS + "report/nt_counts.py",
            base="report",
            primeiro=NT_INDICES[0],
            ultimo=NT_INDICES[-1],
        shell:
            "mkdir -p report/clark && python {params.script} {wildcards.sample} . "
            "{params.base} {params.primeiro} {params.ultimo}"


if CLARK or ROTA_NT:

    # A pagina HTML com a contagem por especie, usada pelas duas rotas.
    rule taxon_html:
        input:
            "report/clark/{sample}.count",
        output:
            html="report/clark/{sample}.html",
            csv="report/clark/{sample}.count.csv",
        params:
            script=SCRIPTS + "report/taxon_html.py",
        shell:
            "python {params.script} {input} {output.csv} {output.html}"


if REMONTAR:

    # Junta os contigs de todas as amostras e faz um consenso unico entre elas.
    rule reassemble_pool:
        input:
            expand("fastq/{sample}_contig4", sample=SAMPLES),
        output:
            temp("bowtieContig/all.cap3"),
        shell:
            "mkdir -p bowtieContig && cat {input} > {output}"

    rule reassemble_consensus:
        input:
            "bowtieContig/all.cap3",
        output:
            contigs=temp("bowtieContig/all.cap3.cap.contigs"),
            singlets=temp("bowtieContig/all.cap3.cap.singlets"),
        params:
            cap3=TOOLS["cap3"],
        shell:
            "{params.cap3} {input} -o 25 -p 85 -h 40"

    # So os contigs longos viram referencia para o mapeamento.
    rule reassemble_reference:
        input:
            contigs="bowtieContig/all.cap3.cap.contigs",
            singlets="bowtieContig/all.cap3.cap.singlets",
        output:
            "ref.fasta",
        params:
            script=SCRIPTS + "assembly/filter_contig_length.py",
            min_length=cfg["params.reassemble_min_length"],
        shell:
            "cat {input.singlets} {input.contigs} > bowtieContig/all.cap3cap3 && "
            "python {params.script} bowtieContig/all.cap3cap3 {output} "
            "{params.min_length} dummy"

    rule reassemble_index:
        input:
            "ref.fasta",
        output:
            multiext("bowtieContig/allbow", ".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2",
                     ".rev.1.bt2", ".rev.2.bt2"),
        params:
            bowtie2_build=TOOLS["bowtie2_build"],
        shell:
            "{params.bowtie2_build} {input} bowtieContig/allbow"

    # Cada amostra volta a ser alinhada contra o consenso, para medir abundancia.
    rule reassemble_align:
        input:
            indice="bowtieContig/allbow.1.bt2",
            r1=lambda w: FASTQ[(w.sample, "1")],
            r2=lambda w: FASTQ[(w.sample, "2")],
        output:
            temp("bowtieContig/{sample}.sam"),
        params:
            bowtie2=TOOLS["bowtie2"],
        threads: cfg["compute.threads"]
        shell:
            "{params.bowtie2} --fast-local --quiet --local --no-hd --reorder "
            "-p {threads} -L 30 -x bowtieContig/allbow -1 {input.r1} -2 {input.r2} "
            "-S {output}"

    rule reassemble_counts:
        input:
            "bowtieContig/{sample}.sam",
        output:
            "bowtieContig/{sample}.count",
        params:
            script=SCRIPTS + "report/contig_counts.py",
        shell:
            "python {params.script} {input} {output}"

    # A tabela final: um contig por linha, uma amostra por coluna.
    rule reassemble_table:
        input:
            ref="ref.fasta",
            counts=expand("bowtieContig/{sample}.count", sample=SAMPLES),
        output:
            "report/reAssemble/tally.txt",
        params:
            script=SCRIPTS + "report/contig_table.py",
        shell:
            "mkdir -p report/reAssemble && python {params.script} {input.ref} "
            "{input.counts} {output}"


# Copia os relatorios prontos para a pasta que o site publica.
rule publish:
    input:
        summaries=expand("blast_filter_out/{sample}_blast_filter.html", sample=SAMPLES),
        all_summary="blast_filter_out/all_blast_filter.html",
        index="report/index.html",
        table="report/hitTable",
        pies=expand("report/pie/{sample}_blast_filter.png", sample=SAMPLES),
        histograms=expand(
            "report/hist/{sample}_{pair}_{stage}_hist.png",
            sample=SAMPLES, pair=["1"], stage=["raw", "clean"],
        ),
    output:
        touch("report/.published"),
    params:
        php=WEB + "*.php",
        assets=WEB + "tablestyle.css " + WEB + "wait.gif",
    shell:
        "cp -r blast_filter_out/aln blast_filter_out/fasta report/ 2>/dev/null || true; "
        "cp blast_filter_out/*.html blast_filter_out/*.xls report/ 2>/dev/null || true; "
        "cp {params.php} {params.assets} report/ 2>/dev/null || true"
