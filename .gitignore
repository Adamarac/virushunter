# Python
*.pyc
*.pyo
__pycache__/

# Generated by virus_hunter.py at run time.
# The orchestrator writes ~40 shell scripts plus a pipeline_run.sh into the
# working directory; those are the real executable artifacts of a run and are
# reproducible from the source, so they are not versioned.
pipeline_run.sh
server.info
server.txt
run.log
*.log
*.logg
*.time

# Job lists consumed by schedule2.py
bowtieBac.txt
blast_virus.txt
blast_nr.txt
blast_nr_mystery.txt
diamond_nr.txt
rap_nr.txt

# Run output directories
fastq/
NT/
clark_out/
soap_config/
soap_out/
soap_partition_config/
soap_partition_out/
abyss_*/
velvet_*/
trinity_*/
contig_*/
blast_virus_out/
blast_nr_out/
blast_filter_out/
diamond_nr_out/
bowtieContig/
blastn/

# Editors / OS
.DS_Store
*.swp

# Artefatos temporarios da verificacao de referencia
.ref_verify/
.ref_diff.txt
.ref_run*/

# Fecho vivo, recalculado sob demanda por tests/live_closure.py
.closure*.txt
.smoke_out.txt
.identity_out.txt
.gzip_out.txt

# Build / empacotamento
build/
dist/
*.egg-info/
.pytest_cache/
.dag_out.txt

# A referencia congelada usa os mesmos nomes dos artefatos de execucao acima.
# Sem esta excecao um clone novo teria referencia incompleta -- incluindo o
# pipeline_run.sh, que descreve a ordem de execucao.
!tests/reference/expected/**
.dagcheck/

# Artefatos de execucao do Snakemake, nao versionados.
.snakemake/
